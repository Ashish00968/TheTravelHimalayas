  <metadata>
    <name>Beas Kund Trek (DHT Route)</name>
    <desc>Ground-surveyed field GPS trace via WaymarkedTrails and OSM. Free to use with credit.</desc>
    <author><name>Discover Himalayan Trails</name></author>
