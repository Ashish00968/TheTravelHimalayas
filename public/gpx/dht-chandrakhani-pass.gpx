  <wpt lat="32.115618" lon="77.174437"><ele>1866</ele><name>Rumsu Village Heritage Base</name><desc>Ancient wooden temple base camp at Rumsu village above Naggar Castle.</desc></wpt>
  <wpt lat="32.095000" lon="77.185000"><ele>2480</ele><name>Stelling Forest Meadow Camp</name><desc>Shaded forest clearing nestled within colossal pine and deodar forests.</desc></wpt>
  <wpt lat="32.082000" lon="77.198000"><ele>3100</ele><name>Naya Tapru Shepherd Pasture</name><desc>High alpine meadow grazing ground with vistas of the Pir Panjal range.</desc></wpt>
  <wpt lat="32.072736" lon="77.209352"><ele>3660</ele><name>Chandrakhani Pass Summit Crest</name><desc>360-degree panorama of Deo Tibba, Indrasan, and the Parvati Valley.</desc></wpt>
  <wpt lat="32.062000" lon="77.235000"><ele>3050</ele><name>Nagroni High Alpine Camp</name><desc>High camp along the steep eastern descent toward the secluded Malana gorge.</desc></wpt>
