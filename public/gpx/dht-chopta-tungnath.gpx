    <link href="https://discoverhimalayantrails.com/explore/uttarakhand/rudraprayag/chopta-tungnath"><text>Trek page</text></link>
  </metadata>
  <wpt lat="30.484900" lon="79.200300"><ele>2680</ele><name>Chopta Roadhead Trailhead</name><desc>The &apos;Mini Switzerland of Uttarakhand&apos;, forested roadhead on the Kedarnath-Badrinath highway.</desc></wpt>
  <wpt lat="30.488000" lon="79.215000"><ele>3680</ele><name>Tungnath Ancient Shiva Temple</name><desc>Highest of the Panch Kedar temples and the highest Shiva shrine in the world at 3,680m.</desc></wpt>
  <wpt lat="30.486400" lon="79.221200"><ele>4000</ele><name>Chandrashila Moon Rock Summit</name><desc>Commanding 360° summit peak offering jaw-dropping vistas of Nanda Devi, Trishul, and Chaukhamba.</desc></wpt>
