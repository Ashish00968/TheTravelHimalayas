  <wpt lat="30.817800" lon="78.599500"><ele>2170</ele><name>Raithal Village Trailhead</name><desc>Traditional Garhwali village with 500-year-old timber house heritage.</desc></wpt>
  <wpt lat="30.825000" lon="78.585000"><ele>2900</ele><name>Gui Oak Forest Campsite</name><desc>Sheltered forest clearing with traditional Gujjar shepherd huts.</desc></wpt>
  <wpt lat="30.832000" lon="78.572000"><ele>3340</ele><name>Dayara Bugyal Meadow Crest</name><desc>Vast expanse of lush velvet undulating meadows stretching to the horizon.</desc></wpt>
  <wpt lat="30.836600" lon="78.565400"><ele>3657</ele><name>Bakaria Top High Summit Knoll</name><desc>Highest point of Dayara Bugyal offering sweeping views of Bandarpoonch and Draupadi Ka Danda.</desc></wpt>
