  <wpt lat="32.197480" lon="77.205220"><ele>1897</ele><name>Jagatsukh / Bhanara Roadhead</name><desc>Traditional alpine roadhead in Jagatsukh village along the Duhangan Nullah.</desc></wpt>
  <wpt lat="32.200654" lon="77.267960"><ele>3122</ele><name>Chikka Forest Camp</name><desc>Pristine forest clearing along the roaring Duhangan torrent.</desc></wpt>
  <wpt lat="32.184913" lon="77.327420"><ele>3858</ele><name>Seri Vast Glacial Basin</name><desc>Expansive former glacial lake bed now carpeted in alpine turf and braided streams.</desc></wpt>
  <wpt lat="32.175094" lon="77.369825"><ele>4424</ele><name>Chhota Chandratal Base Camp</name><desc>Sacred emerald glacial tarn resting beneath the colossal Deo Tibba icefall.</desc></wpt>
  <wpt lat="32.178664" lon="77.392475"><ele>5180</ele><name>Duhangan Col High Camp 1</name><desc>Alpine col connecting the Kullu and Malana glacial basins.</desc></wpt>
  <wpt lat="32.195240" lon="77.382599"><ele>6001</ele><name>Deo Tibba Glaciated Summit Dome</name><desc>Monumental 6,001m snow dome pinnacle towering over the Pir Panjal and Great Himalayan ranges.</desc></wpt>
