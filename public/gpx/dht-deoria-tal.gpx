  <wpt lat="30.515400" lon="79.096300"><ele>1416</ele><name>Sari Village Base Roadhead</name><desc>Traditional Garhwali village roadhead and primary base for Deoria Tal.</desc></wpt>
  <wpt lat="30.520000" lon="79.110000"><ele>1950</ele><name>Rhododendron Forest Trail</name><desc>Shaded stone-paved trail ascending through blooming rhododendron forests.</desc></wpt>
