  <wpt lat="30.994200" lon="78.940500"><ele>3100</ele><name>Gangotri Temple Town Trailhead</name><desc>Holy shrine of Goddess Ganga in Gangotri National Park.</desc></wpt>
  <wpt lat="30.965000" lon="78.995000"><ele>3580</ele><name>Chirbasa Pine Oasis</name><desc>Stand of fragrant pine trees beside the rushing Bhagirathi river.</desc></wpt>
  <wpt lat="30.935000" lon="79.035000"><ele>3790</ele><name>Bhojbasa Birch Forest Basecamp</name><desc>GMVN resthouse and camping grounds with prime views of the Bhagirathi peaks.</desc></wpt>
  <wpt lat="30.925000" lon="79.065000"><ele>4000</ele><name>Gaumukh Glacier Snout</name><desc>Physical origin of the holy River Ganga from the Gangotri glacier.</desc></wpt>
