  <wpt lat="32.259491" lon="77.241188"><ele>2772</ele><name>Jobra Roadhead Trailhead</name><desc>Roadhead entry near Prini &amp; Sethan dam. Forest entry point.</desc></wpt>
  <wpt lat="32.273808" lon="77.250168"><ele>3120</ele><name>Chika Alpine Meadow Camp</name><desc>Lush grassy meadow campsite framed by the roaring Rani Nullah river.</desc></wpt>
  <wpt lat="32.282974" lon="77.256380"><ele>3450</ele><name>Jwara Glacial Stream Crossing</name><desc>River crossing over cold glacial snowmelt with wildflower pastures.</desc></wpt>
  <wpt lat="32.280097" lon="77.294311"><ele>3780</ele><name>Balu ka Ghera High Camp</name><desc>Vast sandy clearing beneath the terminal moraine and jagged peaks.</desc></wpt>
  <wpt lat="32.270859" lon="77.335023"><ele>4287</ele><name>Hampta Pass Summit Col</name><desc>Iconic alpine pass col connecting Kullu with the stark Chandra Valley.</desc></wpt>
  <wpt lat="32.269317" lon="77.342318"><ele>3900</ele><name>Shea Goru Oasis Campsite</name><desc>Coldest campsite in the valley resting alongside turquoise glacial braided streams.</desc></wpt>
  <wpt lat="32.318706" lon="77.363784"><ele>3340</ele><name>Chhatru Roadhead Outpost</name><desc>End of foot trail. Road junction on the Chandra River with highway access to Kaza and Manali.</desc></wpt>
