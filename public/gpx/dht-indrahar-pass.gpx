  </metadata>
  <wpt lat="32.254340" lon="76.325780"><ele>2101</ele><name>Galu Devi Temple Trailhead</name><desc>Upper Dharamkot roadhead and primary gateway trailhead for Triund and Indrahar Pass.</desc></wpt>
  <wpt lat="32.256370" lon="76.341970"><ele>2401</ele><name>Magic View Cafe Ridge Junction</name><desc>Historic tea shop and trail resting point on the rhododendron ridge overlooking Kangra valley.</desc></wpt>
  <wpt lat="32.263070" lon="76.354100"><ele>2853</ele><name>Triund Panoramic Ridge Plateau</name><desc>Expansive grassy ridge plateau directly beneath the sheer south face of Moon Peak.</desc></wpt>
  <wpt lat="32.271170" lon="76.359370"><ele>3153</ele><name>Snowline Cafe &amp; Ilaqa Got Meadow</name><desc>Glacial amphitheater basecamp situated above the tree line at the base of the main Dhauladhar wall.</desc></wpt>
  <wpt lat="32.287860" lon="76.372750"><ele>3506</ele><name>Lahesh Natural Rock Cave</name><desc>Famous natural shepherd rock shelter used for pre-dawn summit assault camping.</desc></wpt>
  <wpt lat="32.292940" lon="76.375370"><ele>3860</ele><name>Dhauladhar Boulder Scree &amp; Snow Gully</name><desc>Strenuous scramble over steep granite boulders and snow chutes.</desc></wpt>
  <wpt lat="32.297730" lon="76.381110"><ele>4334</ele><name>Indrahar Pass Summit Col</name><desc>Commanding pass col offering 360° vistas of Mani Mahesh Kailash and the Pir Panjal range.</desc></wpt>
