  </metadata>
  <wpt lat="32.273426" lon="76.361574"><ele>3154</ele><name>Ilaqa Got Meadow Basecamp</name><desc>Glacial amphitheater meadow situated above the tree line at the base of the main Dhauladhar wall.</desc></wpt>
  <wpt lat="32.288025" lon="76.372583"><ele>3516</ele><name>Lahesh Natural Rock Cave</name><desc>Famous natural shepherd rock shelter used for pre-dawn summit assault camping.</desc></wpt>
  <wpt lat="32.294147" lon="76.376785"><ele>3973</ele><name>Dhauladhar Boulder Moraine Gully</name><desc>Strenuous climb over steep granite boulders and snow chutes.</desc></wpt>
  <wpt lat="32.299007" lon="76.383405"><ele>4342</ele><name>Indrahar Pass Summit Col</name><desc>Commanding pass col offering 360° vistas of Mani Mahesh Kailash and Pir Panjal.</desc></wpt>
  <wpt lat="32.309832" lon="76.393771"><ele>3585</ele><name>Chhata Parao High Meadow</name><desc>First camping meadow on the Chamba descent beside glacial streams.</desc></wpt>
  <wpt lat="32.372004" lon="76.506428"><ele>1854</ele><name>Kuwarsi Valley Trailhead Outpost</name><desc>Historic Gaddi tribal village in Bharmour with road connectivity to Chamba.</desc></wpt>
