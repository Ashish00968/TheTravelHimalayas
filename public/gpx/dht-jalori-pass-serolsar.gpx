  <wpt lat="31.537211" lon="77.372809"><ele>3096</ele><name>Jalori Pass Trailhead</name><desc>High vehicular pass (3,120m) connecting Kullu and Shimla. Trail starts beside Mahakali Temple.</desc></wpt>
  <wpt lat="31.535659" lon="77.378924"><ele>3231</ele><name>Oak &amp; Rhododendron Forest Ridge</name><desc>Moss-draped oak canopies with blooming red rhododendrons in spring.</desc></wpt>
  <wpt lat="31.536500" lon="77.395000"><ele>3210</ele><name>Tirthan Valley Ridge Clearing</name><desc>Panoramic clearing overlooking the Great Himalayan National Park mountain ramparts.</desc></wpt>
  <wpt lat="31.537893" lon="77.416846"><ele>3188</ele><name>Serolsar Lake &amp; Buddhi Nagin Shrine</name><desc>Sacred emerald tarn without a leaf on its surface, dedicated to the guardian snake deity.</desc></wpt>
