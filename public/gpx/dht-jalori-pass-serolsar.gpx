  <wpt lat="31.537000" lon="77.373000"><ele>3131</ele><name>Jalori Pass Summit Crest</name><desc>High motorable pass (3,120m) connecting Kullu with Shimla district.</desc></wpt>
  <wpt lat="31.538000" lon="77.380000"><ele>3170</ele><name>Ancient Oak Forest Trail</name><desc>Enchanting trail through centuries-old Kharshu oak and rhododendron forests.</desc></wpt>
