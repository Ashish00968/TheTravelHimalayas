  <wpt lat="34.351800" lon="74.974000"><ele>2360</ele><name>Shitkadi / Sonmarg Trailhead</name><desc>Meadow campsite on the banks of the Sindh River near Sonmarg.</desc></wpt>
  <wpt lat="34.310000" lon="75.060000"><ele>4100</ele><name>Nichnai High Pass Col</name><desc>First major high pass crossover into the Vishansar basin.</desc></wpt>
  <wpt lat="34.290000" lon="75.120000"><ele>3710</ele><name>Vishansar &amp; Kishansar Twin Lakes</name><desc>Trout-filled twin alpine lakes beneath the sheer precipices of Mount Kishansar.</desc></wpt>
  <wpt lat="34.330000" lon="75.180000"><ele>4200</ele><name>Gadsar Pass &amp; Floating Ice Lake</name><desc>Summit col overlooking Gadsar, the &apos;Lake of Flowers&apos;.</desc></wpt>
  <wpt lat="34.340000" lon="75.210000"><ele>3600</ele><name>Satsar Multi-Lake Basin</name><desc>Interconnected chain of seven alpine lakes nestled along the mountain fold.</desc></wpt>
  <wpt lat="34.320000" lon="75.245000"><ele>3570</ele><name>Gangabal &amp; Nundkol Lakes</name><desc>Twin sacred lakes reflecting the colossal ice face of Mount Harmukh (5,142m).</desc></wpt>
  <wpt lat="34.302600" lon="75.261600"><ele>2280</ele><name>Naranag Ancient Temple Trailhead</name><desc>8th-century stone temple complex and end of the expedition.</desc></wpt>
