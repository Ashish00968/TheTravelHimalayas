  </metadata>
  <wpt lat="31.072600" lon="78.190100"><ele>1950</ele><name>Sankri Roadhead Trailhead</name><desc>Charming wooden village roadhead in Govind Wildlife Sanctuary.</desc></wpt>
  <wpt lat="31.055000" lon="78.182000"><ele>2770</ele><name>Juda Ka Talab Frozen Tarn</name><desc>Legendary high-altitude lake framed by giant oak and pine trees.</desc></wpt>
  <wpt lat="31.049000" lon="78.179000"><ele>3400</ele><name>Kedarkantha Base Camp (Talkhetra)</name><desc>Wide open snowy meadow with direct line of sight to the summit pyramidal horn.</desc></wpt>
  <wpt lat="31.046000" lon="78.179500"><ele>3680</ele><name>Kedarkantha Summit Ridge Push</name><desc>Final steep ridge climb to the peak.</desc></wpt>
  <wpt lat="31.045100" lon="78.178700"><ele>3800</ele><name>Kedarkantha Summit Peak</name><desc>Iconic Shiva shrine cairn offering unmatched 360° panoramas of Swargarohini, Bandarpoonch, and Black Peak.</desc></wpt>
