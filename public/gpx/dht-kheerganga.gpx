  <wpt lat="32.002229" lon="77.451454"><ele>2195</ele><name>Barshaini Dam Trailhead</name><desc>Roadhead past Manikaran &amp; Kasol. Trailhead entry beside the Parvati River dam.</desc></wpt>
  <wpt lat="31.996500" lon="77.468000"><ele>2300</ele><name>Nakthan Traditional Village</name><desc>Ancient wooden timber houses, apple orchards, and traditional homestays.</desc></wpt>
  <wpt lat="31.992000" lon="77.478000"><ele>2450</ele><name>Rudranag Sacred Waterfalls</name><desc>Serpentine cascading waterfall and Lord Shiva shrine with clean glacial drinking water.</desc></wpt>
  <wpt lat="31.995000" lon="77.485000"><ele>2700</ele><name>Pine Forest Gorge Ascent</name><desc>Dense pine and oak woodland trail.</desc></wpt>
  <wpt lat="31.998401" lon="77.492513"><ele>2960</ele><name>Kheerganga Geothermal Hot Springs</name><desc>Alpine meadow with natural geothermal sulfur pools with views of glaciated peaks.</desc></wpt>
