  <wpt lat="31.528800" lon="78.282300"><ele>1987</ele><name>Tangling Village Trailhead</name><desc>Riverside village base on the left bank of the Sutlej River near Powari.</desc></wpt>
  <wpt lat="31.530000" lon="78.310000"><ele>3000</ele><name>Ashirwad Bhawan Forest Clearing</name><desc>First major overnight resting shelter among high-altitude pine glades.</desc></wpt>
  <wpt lat="31.532000" lon="78.330000"><ele>3850</ele><name>Maling Khata Alpine Meadow</name><desc>Expansive high meadow camp situated directly beneath the rocky ridge.</desc></wpt>
  <wpt lat="31.535000" lon="78.345000"><ele>4400</ele><name>Parvati Kund Glacial Tarn</name><desc>Sacred high glacial tarn where pilgrims offer prayers before the final summit push.</desc></wpt>
  <wpt lat="31.536500" lon="78.353800"><ele>4816</ele><name>Kinner Kailash Rock Pillar Shivling</name><desc>79-foot natural monolithic vertical rock pillar revered as the sacred abode of Lord Shiva.</desc></wpt>
