  <wpt lat="30.481900" lon="79.589500"><ele>2875</ele><name>Dhak Village Roadhead Trailhead</name><desc>Roadhead near Joshimath initiating the historic Lord Curzon Trail.</desc></wpt>
  <wpt lat="30.480000" lon="79.585000"><ele>3050</ele><name>Gulling &amp; Tugasi Terraced Pastures</name><desc>Picturesque Himalayan villages overlooking Dhauli Ganga canyon.</desc></wpt>
