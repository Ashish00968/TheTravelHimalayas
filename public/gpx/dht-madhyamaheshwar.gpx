  </metadata>
  <wpt lat="30.589600" lon="79.154500"><ele>1902</ele><name>Ransi Village Roadhead Trailhead</name><desc>End of the motor road in the Madhyamaheshwar Ganga river valley.</desc></wpt>
  <wpt lat="30.605000" lon="79.175000"><ele>2100</ele><name>Gaundhar &amp; Bantoli River Confluence</name><desc>Scenic bridge crossing at the roaring confluence of Madhyamaheshwar Ganga and Markanga Ganga.</desc></wpt>
  <wpt lat="30.618000" lon="79.195000"><ele>2550</ele><name>Nanu Chatti Oak Forest Rest Point</name><desc>Midway steep ascent halt point surrounded by dense oak and rhododendron forests.</desc></wpt>
  <wpt lat="30.633100" lon="79.220700"><ele>3249</ele><name>Madhyamaheshwar Panch Kedar Temple</name><desc>Fourth Panch Kedar shrine nestled in a green bowl meadow beneath Mount Chaukhamba.</desc></wpt>
  <wpt lat="30.636000" lon="79.225000"><ele>3400</ele><name>Budha Madhyamaheshwar Meadow Ridge</name><desc>Upper meadow ridge reflecting the four-peaked mass of Chaukhamba in a high alpine pond.</desc></wpt>
