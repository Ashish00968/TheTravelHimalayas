  <wpt lat="32.453900" lon="76.613600"><ele>2092</ele><name>Hadsar Roadhead Trailhead</name><desc>Motorable terminus 13 km beyond Bharmour where the sacred pilgrimage trail begins.</desc></wpt>
  <wpt lat="32.430000" lon="76.620000"><ele>2680</ele><name>Dhancho Glacial Waterfall &amp; Camp</name><desc>Thunderous glacial gorge waterfall and primary first-stage overnight campsite.</desc></wpt>
  <wpt lat="32.415000" lon="76.628000"><ele>3150</ele><name>Sundrasi High Meadow Rest Point</name><desc>Midway plateau where vegetation transitions into alpine tundra and scree.</desc></wpt>
  <wpt lat="32.400000" lon="76.634000"><ele>3850</ele><name>Gauri Kund Sacred Women Tarn</name><desc>High-altitude holy tarn situated 1 km before Manimahesh Lake.</desc></wpt>
  <wpt lat="32.395600" lon="76.637300"><ele>4175</ele><name>Manimahesh Sacred Glacial Lake</name><desc>Glacial lake at 4,175m directly beneath the unconquered summit of Mount Manimahesh Kailash (5,653m).</desc></wpt>
