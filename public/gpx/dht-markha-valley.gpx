  <wpt lat="34.125700" lon="77.506300"><ele>3200</ele><name>Chilling / Skiu Trailhead</name><desc>Zanskar River confluence and western gateway to Hemis National Park.</desc></wpt>
  <wpt lat="33.950000" lon="77.550000"><ele>3700</ele><name>Markha Village Oases</name><desc>Largest ancient settlement in the valley with ruined hill fort and monastery.</desc></wpt>
  <wpt lat="33.890000" lon="77.620000"><ele>4150</ele><name>Thachungtse Grazing Pasture</name><desc>Lush shepherd meadow framed by soaring red rock canyon walls.</desc></wpt>
  <wpt lat="33.870000" lon="77.680000"><ele>4720</ele><name>Nimaling High Plateau Basecamp</name><desc>Vast windswept alpine plateau under the massive glacier of Kang Yatse (6,400m).</desc></wpt>
  <wpt lat="33.860000" lon="77.700000"><ele>5269</ele><name>Kongmaru La Summit Pass</name><desc>Highest point of the trek with sweeping views of the Karakoram and Ladakh ranges.</desc></wpt>
  <wpt lat="33.854300" lon="77.707800"><ele>3670</ele><name>Shang Sumdo Roadhead Outpost</name><desc>End of the trail at the eastern roadhead in the Indus Valley.</desc></wpt>
