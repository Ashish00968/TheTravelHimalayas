  <wpt lat="31.617500" lon="78.022000"><ele>2418</ele><name>Kafnu Village Roadhead Trailhead</name><desc>Hydroelectric project village in Kinnaur initiating the lush Bhaba Valley ascent.</desc></wpt>
  <wpt lat="31.660000" lon="78.010000"><ele>3280</ele><name>Mulling Alpine Birch Meadow</name><desc>Forest clearing beside the roaring Bhaba river surrounded by sheer granite walls.</desc></wpt>
  <wpt lat="31.710000" lon="77.998000"><ele>3550</ele><name>Karah River Delta Campsite</name><desc>Vast alluvial grassland where horses and sheep graze under hanging glaciers.</desc></wpt>
  <wpt lat="31.750000" lon="77.995000"><ele>4100</ele><name>Phutsirang High Pass Camp</name><desc>Last high camp at the confluence of glacial streams before the pass push.</desc></wpt>
  <wpt lat="31.779500" lon="77.993200"><ele>5007</ele><name>Pin Bhaba Pass Crest</name><desc>Dramatic crossover portal from the lush green Bhaba valley to the barren crimson desert of Spiti.</desc></wpt>
  <wpt lat="31.850000" lon="78.010000"><ele>4150</ele><name>Mangrungse Cold Desert Camp</name><desc>First campsite on the Spiti side in the stark Pin River valley.</desc></wpt>
  <wpt lat="31.959500" lon="78.031700"><ele>3814</ele><name>Mudh Village Spiti Terminus</name><desc>Historic whitewashed Spitian village roadhead beneath towering purple mountains.</desc></wpt>
