  </metadata>
  <wpt lat="31.999400" lon="77.450400"><ele>2199</ele><name>Barshaini Roadhead Trailhead</name><desc>Primary roadhead base in Parvati Valley initiating the Trans-Himalayan traverse.</desc></wpt>
  <wpt lat="31.991600" lon="77.509900"><ele>2845</ele><name>Kheerganga Geothermal Meadows</name><desc>Famous natural sulfur springs camp overlooking deep pine gorges.</desc></wpt>
  <wpt lat="31.970000" lon="77.580000"><ele>3280</ele><name>Tunda Bhuj Birch Forest Camp</name><desc>Meadow clearing where silver birch trees flourish amidst roaring waterfalls.</desc></wpt>
  <wpt lat="31.940000" lon="77.660000"><ele>3560</ele><name>Thakur Kuan River Gorge</name><desc>Advanced camp inside the Great Himalayan National Park buffer zone.</desc></wpt>
  <wpt lat="31.870000" lon="77.740000"><ele>4116</ele><name>Mantalai Sacred Glacial Lake</name><desc>Vast sacred moraine tarn and source of the Parvati River, flanked by Shivling shrines.</desc></wpt>
  <wpt lat="31.835700" lon="77.844500"><ele>5297</ele><name>Pin Parvati Pass Glaciated Col</name><desc>Formidable 5,297m high col bridging the wet Kullu monsoon basin with the arid Spiti plateau.</desc></wpt>
  <wpt lat="31.890000" lon="77.960000"><ele>4050</ele><name>Tiya High Spiti Pasture</name><desc>Broad desert valley campsite on the banks of the Pin River torrent.</desc></wpt>
  <wpt lat="31.959900" lon="78.030800"><ele>3812</ele><name>Mudh Village Spiti Terminus</name><desc>Ancient Tibetan village with road connectivity to Kaza, terminating the 80 km expedition.</desc></wpt>
