  </metadata>
  <wpt lat="31.133100" lon="78.077800"><ele>1595</ele><name>Dhaula Village Roadhead Trailhead</name><desc>Sleepy hamlet on the Rupin River in Uttarakhand initiating the interstate crossover.</desc></wpt>
  <wpt lat="31.180000" lon="78.090000"><ele>1850</ele><name>Sewa Temple Village</name><desc>Border village featuring a historic Kinnauri-style multi-tiered wooden temple.</desc></wpt>
  <wpt lat="31.230000" lon="78.110000"><ele>2320</ele><name>Jiskoon Hanging Village</name><desc>Dramatic hillside cliff village overlooking vertical Rupin canyon drops.</desc></wpt>
  <wpt lat="31.280000" lon="78.130000"><ele>3250</ele><name>Saruwas Thach Pine Meadow</name><desc>First true alpine meadow camp framed by roaring glacial cascades.</desc></wpt>
  <wpt lat="31.330000" lon="78.145000"><ele>4050</ele><name>Upper Rupin Waterfall Amphitheater</name><desc>Iconic three-tier glacial waterfall dropping from snowfields into an immense alpine bowl.</desc></wpt>
  <wpt lat="31.353900" lon="78.154300"><ele>4669</ele><name>Rupin Pass Snow Gully Col</name><desc>Knife-edge saddle framing spectacular panoramas of Kinner Kailash (6,050m).</desc></wpt>
  <wpt lat="31.390000" lon="78.190000"><ele>3980</ele><name>Ronti Gad High Alpine Pasture</name><desc>Sprawling green meadow camp on the descent into Himachal Pradesh.</desc></wpt>
  <wpt lat="31.427700" lon="78.264100"><ele>2681</ele><name>Sangla Village Kinnaur Terminus</name><desc>Fabled Baspa Valley township in Kinnaur with apple orchards and road connectivity.</desc></wpt>
