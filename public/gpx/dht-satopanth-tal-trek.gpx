  <wpt lat="30.770200" lon="79.491800"><ele>3204</ele><name>Mana Village Roadhead Trailhead</name><desc>India&apos;s first border village 3 km beyond Badrinath initiating the Swargarohini trail.</desc></wpt>
  <wpt lat="30.785000" lon="79.450000"><ele>3750</ele><name>Vasudhara Falls Moraine Overlook</name><desc>122m vertical waterfall dropping down granite walls into the Alaknanda gorge.</desc></wpt>
  <wpt lat="30.775000" lon="79.420000"><ele>3900</ele><name>Laxmi Van Birch Forest Clearing</name><desc>Dense Bhojpatra (silver birch) forest camp flanked by tumbling glaciers.</desc></wpt>
  <wpt lat="30.760000" lon="79.390000"><ele>4200</ele><name>Chakratirtha Glacial Cirque</name><desc>High moraine amphitheater directly beneath Mount Chaukhamba and Balakun.</desc></wpt>
  <wpt lat="30.748900" lon="79.369500"><ele>4374</ele><name>Satopanth Tal Triangular Glacial Tarn</name><desc>Sacred triangular emerald lake where Brahma, Vishnu, and Shiva are said to meditate.</desc></wpt>
