  <wpt lat="34.092600" lon="75.263600"><ele>2434</ele><name>Aru Valley Trailhead</name><desc>Pristine meadow village 12 km from Pahalgam on the banks of Aru river.</desc></wpt>
  <wpt lat="34.155000" lon="75.250000"><ele>2780</ele><name>Lidderwat Alpine Confluence</name><desc>Scenic pine meadow where streams from Kolahoi glacier and Tarsar merge.</desc></wpt>
  <wpt lat="34.165000" lon="75.205000"><ele>3360</ele><name>Shekwas Shepherd Meadow</name><desc>Rolling green boulder meadows beneath high Dzhankhor cliffs.</desc></wpt>
  <wpt lat="34.148000" lon="75.148000"><ele>3790</ele><name>Tarsar Turquoise Alpine Lake</name><desc>Almond-shaped sapphire glacial tarn cradled beneath Mount Kolahoi.</desc></wpt>
  <wpt lat="34.158000" lon="75.132000"><ele>3996</ele><name>Sundersar Camp &amp; Marsar Ridge Overlook</name><desc>Twin lake high vantage overlooking the mystical shrouded waters of Marsar.</desc></wpt>
