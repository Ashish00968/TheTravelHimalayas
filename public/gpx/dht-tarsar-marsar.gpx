  </metadata>
  <wpt lat="34.092100" lon="75.263200"><ele>2428</ele><name>Aru Village Valley Trailhead</name><desc>Idyllic pastoral village 12 km from Pahalgam initiating the Kolahoi basin trail.</desc></wpt>
  <wpt lat="34.140000" lon="75.240000"><ele>2780</ele><name>Lidderwat Pine Glade Campsite</name><desc>River confluence campsite where the trails to Kolahoi Glacier and Tarsar Lake diverge.</desc></wpt>
  <wpt lat="34.150000" lon="75.180000"><ele>3350</ele><name>Shekhwas Alpine Meadow</name><desc>Broad Gujjar grazing pasture with streams cascading through rolling green meadows.</desc></wpt>
  <wpt lat="34.150000" lon="75.140000"><ele>3790</ele><name>Tarsar Almond-Shaped Glacial Lake</name><desc>Renowned royal blue alpine lake surrounded by towering jagged peaks.</desc></wpt>
  <wpt lat="34.152000" lon="75.120000"><ele>3950</ele><name>Sundersar Alpine Tarn</name><desc>Circular high alpine tarn situated in the moraine bowl beneath Tarsar Pass.</desc></wpt>
  <wpt lat="34.152100" lon="75.112000"><ele>4010</ele><name>Marsar Enigmatic High Pass Overlook</name><desc>Vast shrouded glacial tarn notorious for disappearing into cloud cover within minutes.</desc></wpt>
