  <wpt lat="32.240778" lon="76.348127"><ele>2129</ele><name>Karthani Ridge Rest Point</name><desc>Scenic ridge viewpoint overlooking Kangra Valley.</desc></wpt>
  <wpt lat="32.246341" lon="76.350737"><ele>2469</ele><name>Mana Forest Clearing</name><desc>Oak and rhododendron forest clearing with sheltered campsite terrain.</desc></wpt>
