  <wpt lat="30.639000" lon="79.575000"><ele>1920</ele><name>Govindghat / Pulna Trailhead</name><desc>Trailhead starting at the confluence of Alaknanda and Bhyundar Ganga.</desc></wpt>
  <wpt lat="30.700000" lon="79.583000"><ele>3048</ele><name>Ghangaria Gateway Outpost</name><desc>Forest department checkpost and entry gate to the National Park.</desc></wpt>
  <wpt lat="30.710000" lon="79.590000"><ele>3200</ele><name>Pushpawati River Wooden Gorge Bridge</name><desc>Glacial river bridge entering the UNESCO World Heritage valley.</desc></wpt>
  <wpt lat="30.725000" lon="79.610000"><ele>3500</ele><name>Bistorta &amp; Blue Poppy Flower Meadows</name><desc>Expansive alpine floral carpet hosting over 500 species of endemic wildflowers.</desc></wpt>
  <wpt lat="30.735300" lon="79.635300"><ele>3858</ele><name>Joan Margaret Legge Memorial Grave</name><desc>Memorial to the Kew botanist who lost her life studying flowers here in 1939, deep inside the valley.</desc></wpt>
