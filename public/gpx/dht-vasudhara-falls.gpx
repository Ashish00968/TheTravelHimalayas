  <wpt lat="30.769300" lon="79.497500"><ele>3177</ele><name>Mana Village Trailhead</name><desc>Historic border village near Badrinath where the Saraswati River emerges.</desc></wpt>
  <wpt lat="30.772000" lon="79.492000"><ele>3210</ele><name>Bhim Pul Natural Rock Bridge</name><desc>Colossal monolithic boulder straddling the deafening roar of the Saraswati river gorge.</desc></wpt>
  <wpt lat="30.778000" lon="79.475000"><ele>3450</ele><name>Saraswati River Canyon Ascent</name><desc>Rocky moraine trail climbing through alpine scrub above the river valley.</desc></wpt>
  <wpt lat="30.788300" lon="79.452900"><ele>3768</ele><name>Vasudhara Falls 122m Glacial Cascade</name><desc>Spectacular 400-foot glacial waterfall fed by Chaukhamba snowfields.</desc></wpt>
